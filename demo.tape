# Çıktı dosyasının adı ve formatı
Output demo.gif

# Terminal ayarları
Set FontSize 22
Set Width 1200
Set Height 600
Set Theme "Dracula"

# Senaryo (Komutlar)
Type "echo 'AI Agent Başlatılıyor...'"
Sleep 500ms
Enter

Type "cursor --version"
Sleep 1s
Enter

Type "# Ajanlar senkronize ediliyor..."
Sleep 2s

# Ekranı temizle ve bitir
Ctrl+L
Sleep 1s