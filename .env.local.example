# =============================================================================
# Client (browser) — Firebase Web SDK
# Copy to .env.local. Values come from: Firebase Console → Project settings → Your apps → SDK setup
# Enable: Authentication → Sign-in method → Google
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
# =============================================================================
# Server — MongoDB Atlas
# Atlas → Connect → Drivers → copy the Node.js connection string.
# IMPORTANT: URL-encode the password and append the database name (or use MONGODB_DB_NAME).
# =============================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<app-name>
MONGODB_DB_NAME=your-database-name
# =============================================================================
# Server — Firebase Admin SDK (for verifying ID tokens in API routes)
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Paste the private key with literal "\n" sequences (env loader will unescape them).
# =============================================================================
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# =============================================================================
# Server — AI Proxy (LiteLLM / SAKA gateway)
# Local proxy endpoint for LLM calls. Only accessible server-side.
# =============================================================================
AI_PROXY_BASE_URL=http://127.0.0.1:58818
AI_PROXY_API_KEY=your-litellm-api-key
AI_MODEL_NAME=turkcell-glm
# =============================================================================
# Server — Resend (transactional email)
# Resend Dashboard → API Keys → Create API Key
# =============================================================================
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@retromind.app
# =============================================================================
# Public — App URL (used in email CTA buttons and magic links)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
